# SMARTRECRUIT ATS - Server Environment Variables

# Server Config
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
# Connected to local PostgreSQL on port 5433 (database: smartrecruit_ats)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/smartrecruit_ats?schema=public"

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_mock_or_real_key_here
CLERK_PUBLISHABLE_KEY=pk_test_mock_or_real_key_here

# Initial Super Admins (Server-enforced, NEVER from client)
SUPER_ADMIN_EMAILS="yhykk8899@gmail.com,saadtoufik67@gmail.com"

# AI Configuration (Gemini API or local hybrid engine)
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Email Configuration (Nodemailer - SMTP or Ethereal / Console mode)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartRecruit ATS <recrutement@smartrecruit-ats.com>"
SMTP_ENABLED=false

# File Storage Configuration
STORAGE_PATH="./storage"
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES="application/pdf"

# JWT Secret for Signed Temporary URLs & Session fallback
